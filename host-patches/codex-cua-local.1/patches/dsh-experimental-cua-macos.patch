--- a/native/Sources/CuaNative/NativeTaskWindow.swift
+++ b/native/Sources/CuaNative/NativeTaskWindow.swift
@@ -0,0 +1,25 @@
+// A retained window identity, not an application/input authorization. No AX tree or values.
+import Foundation
+import ApplicationServices
+
+final class NativeTaskWindow: @unchecked Sendable {
+    let owner: ProcessIdentity
+    let windowID: UInt32
+    private let element: AXUIElement
+    private let timeout: Float
+    private let cancellation: CancellationLatch
+    init(owner: ProcessIdentity, windowID: UInt32, element: AXUIElement, timeout: Float, cancellation: CancellationLatch) {
+        self.owner = owner; self.windowID = windowID; self.element = element
+        self.timeout = timeout; self.cancellation = cancellation
+    }
+    func require() throws {
+        try cancellation.check()
+        try NativePlatform.verify(owner)
+        _ = try NativePlatform.ownedWindow(owner.pid, windowID)
+        let access = AXAccess(timeout: timeout, cancellation: cancellation)
+        let current = try access.children(AXUIElementCreateApplication(owner.pid), "AXWindows")
+        guard try current.contains(where: { try access.windowID($0) == windowID && CFEqual($0, element) }) else {
+            throw NativeFailure(code: "CUA_TARGET_STALE", message: "Selected window was closed or replaced; operator must select again")
+        }
+    }
+}
