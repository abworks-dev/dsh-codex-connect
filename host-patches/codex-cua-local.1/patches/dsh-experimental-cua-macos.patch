--- a/native/Sources/CuaNative/WindowScopePolicy.swift
+++ b/native/Sources/CuaNative/WindowScopePolicy.swift
@@ -0,0 +1,17 @@
+// Local candidate: pure identity policy shared by AX observation and dispatch.
+enum WindowScopeViolation: Error, Equatable {
+    case menu
+    case unknown
+    case mismatch
+}
+struct WindowScopePolicy {
+    // Pointer fallbacks must keep the snapshot window after AX geometry reads.
+    static func requireRoute(expected: UInt32?, actual: UInt32) throws {
+        if let expected, actual != expected { throw WindowScopeViolation.mismatch }
+    }
+    static func require(role: String, expected: UInt32, resolve: () throws -> UInt32?) throws {
+        if role.hasPrefix("AXMenu") { throw WindowScopeViolation.menu }
+        guard let actual = try resolve() else { throw WindowScopeViolation.unknown }
+        guard actual == expected else { throw WindowScopeViolation.mismatch }
+    }
+}
