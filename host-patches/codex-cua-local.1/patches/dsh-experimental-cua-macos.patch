+        do {
+            try WindowScopePolicy.require(role: role, expected: expected) {
+                if let direct = try windowID(element) {
+                    _ = try NativePlatform.ownedWindow(owner.pid, direct)
+                    return direct
+                }
+                if let window = try self.element(element, "AXWindow"), let id = try windowID(window) {
+                    _ = try NativePlatform.ownedWindow(owner.pid, id)
+                    return id
+                }
+                return try enclosingWindow(element, owner: owner).windowID
+            }
+        } catch is WindowScopeViolation {
+            throw NativeFailure(code: "WINDOW_SCOPE_MISMATCH", message: "Element is not a non-menu element of the observed window")
+        }
